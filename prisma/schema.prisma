datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  telegramId       String?           @unique
  username         String?
  firstName        String?
  lastName         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  skillLevels      SkillLevel[]
  reviewItems      ReviewItem[]
  reviewAttempts   ReviewAttempt[]
  dailySessions    DailySession[]
  weeklySessions   WeeklySession[]
  projects         Project[]
  interviews       Interview[]
  aiUsages         AIUsage[]
}

model Skill {
  id          String       @id @default(uuid())
  name        String       @unique
  domain      String       // e.g. "JS/TS", "React", "Next.js", "Backend/API", "PostgreSQL", "System Design"
  description String?
  weight      Int          @default(10) // Weight out of 100
  createdAt   DateTime     @default(now())
  
  topics      Topic[]
  tasks       Task[]
  skillLevels SkillLevel[]
}

model SkillLevel {
  id              String      @id @default(uuid())
  userId          String
  skillId         String
  currentLevel    Int         @default(0) // 0 to 6
  verifiedLevel   Int         @default(0) // 0 to 6
  confidence      Float       @default(0.0) // 0.0 to 1.0
  retentionStatus String      @default("NEW") // NEW, RETENTION_OK, RISKY, FORGOTTEN
  aiDependency    Float       @default(0.0) // 0.0 to 1.0
  evidenceCount   Int         @default(0)
  recentFailures  Int         @default(0)
  lastVerifiedAt  DateTime?
  updatedAt       DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model Topic {
  id          String     @id @default(uuid())
  skillId     String
  title       String
  description String?

  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id              String       @id @default(uuid())
  topicId         String
  title           String
  content         String
  difficulty      Int          @default(1)
  referenceAnswer String
  rubric          String?      // JSON stringified rubric
  rubricVersion   Int          @default(1)

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reviewItems ReviewItem[]
}

model Task {
  id              String       @id @default(uuid())
  skillId         String
  title           String
  description     String
  type            String       @default("CODING") // THEORY_RECALL, EXPLANATION, CODING, DEBUGGING, BUILD_SAAS
  difficulty      Int          @default(1)
  initialCode     String?
  solutionCode    String?
  rubric          String?      // JSON stringified rubric

  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  reviewItems ReviewItem[]
}

model ReviewItem {
  id            String      @id @default(uuid())
  userId        String
  questionId    String?
  taskId        String?
  dueAt         DateTime    @default(now())
  intervalDays  Int         @default(1)
  repetitions   Int         @default(0)
  easeFactor    Float       @default(2.5)
  status        String      @default("QUEUED") // QUEUED, STARTED, SUBMITTED, GRADED, REMEDIATION
  createdAt     DateTime    @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question?        @relation(fields: [questionId], references: [id], onDelete: SetNull)
  task     Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  attempts ReviewAttempt[]

  @@index([userId, dueAt])
}

model ReviewAttempt {
  id           String     @id @default(uuid())
  reviewItemId String
  userId       String
  quality      Int        // Quality score: 0 (failed) to 4 (perfect recall + applied correctly)
  response     String
  errorType    String?    // KNOWLEDGE_GAP, MEMORY_LAPSE, APPLICATION_GAP, DEBUGGING_GAP, CARELESS_ERROR
  confidence   Float      @default(1.0)
  isAiAssisted Boolean    @default(false)
  createdAt    DateTime   @default(now())

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DailySession {
  id             String    @id @default(uuid())
  userId         String
  sessionDate    String    // YYYY-MM-DD
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  totalItems     Int       @default(0)
  completedItems Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionDate])
}

model WeeklySession {
  id          String    @id @default(uuid())
  userId      String
  year        Int
  weekNumber  Int
  status      String    @default("PENDING")
  score       Float     @default(0.0)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, weekNumber])
}

model Project {
  id            String              @id @default(uuid())
  userId        String
  name          String
  description   String?
  repositoryUrl String?
  createdAt     DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoints ProjectCheckpoint[]
}

model ProjectCheckpoint {
  id            String      @id @default(uuid())
  projectId     String
  category      String      // Auth, Database, RequestFlow, Deployment, etc.
  title         String
  status        String      @default("NOT_AUDITED") // NOT_AUDITED, PARTIALLY_UNDERSTOOD, UNDERSTOOD, VERIFIED
  evidenceNotes String?
  updatedAt     DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Interview {
  id        String   @id @default(uuid())
  userId    String
  company   String
  position  String   @default("Middle Full-stack")
  date      DateTime
  outcome   String?  // PASSED, REJECTED, OFFER, PENDING
  feedback  String?
  createdAt DateTime @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]
}

model InterviewQuestion {
  id          String   @id @default(uuid())
  interviewId String
  question    String
  topic       String?
  response    String?
  rating      Int?     // 1-5

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id           String   @id @default(uuid())
  provider     String   // "ollama" | "openrouter" | "huggingface"
  model        String
  promptType   String   // "coding" | "grading" | "explanation" | "task_gen"
  prompt       String
  response     String?
  latencyMs    Int?
  status       String   @default("SUCCESS") // "SUCCESS" | "ERROR"
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AIUsage {
  id           String   @id @default(uuid())
  userId       String
  date         String   // YYYY-MM-DD
  requestCount Int      @default(0)
  provider     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, provider])
}
